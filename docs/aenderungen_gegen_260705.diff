+#define NDEBUG 1
+
+
+/****************************************************************/
+// Allgemeine Konfiguration
+/****************************************************************/
+#define WeckIntervall       10          //  Weckintervall / Messzyklus
+
+#define WeckIntervall_aktiv  1          // Manuelle Intervallsteuerung 0 = inaktiv, 1 = aktiv
