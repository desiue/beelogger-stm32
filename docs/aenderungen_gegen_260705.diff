+
+#define WeckIntervall_Winter_aktiv  0   // Intervall Winter 0 = inaktiv, 1 = aktiv
+#define WeckIntervall_Winter       60   // Intervall in Minuten
+#define WeckIntervall_Winter_Anfang 9   // Monat Winterintervall Start
